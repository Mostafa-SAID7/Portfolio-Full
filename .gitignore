# ---- .NET -------------------------------------------------------------
[Bb]in/
[Oo]bj/
publish/
*.user
*.suo
.vs/
# Publish profiles embed deploy credentials (e.g. site99981-WebDeploy.pubxml).
**/PublishProfiles/*.pubxml
# The tracked solution lives at the repository root (Portfolio.sln); ignore the
# Visual Studio duplicate that appears inside PortfolioAPI/.
PortfolioAPI/PortfolioAPI.sln
# Runtime upload store (cover images etc.) — server data, never in git.
**/App_Data/

# Local/secrets configuration — never commit these.
# appsettings.Development.json carries the local connection string;
# appsettings.Production.json (if used) carries production secrets.
appsettings.Development.json
appsettings.Production.json
!appsettings.Production.json.example

# ---- Node / frontends -------------------------------------------------
node_modules/
dist/
.angular/
.pnpm-store/
*.tsbuildinfo

# ---- Vercel / Nitro build output --------------------------------------
.vercel/
.nitro/
.output/
.tanstack/

# ---- Environment files (frontend secrets live in Vercel's dashboard) ---
.env
.env.*
!.env.example
# Dev-only API origin (localhost) — no secrets, committed so dev works out of the box.
!.env.development

# ---- Misc -------------------------------------------------------------
*.log
.DS_Store
Thumbs.db
