# Development-only API origin (vite dev runs mode=development).
# Local API is started from PortfolioAPI with `ASPNETCORE_URLS=http://localhost:5039`.
# Production builds ignore this file: API_BASE falls back to "" and all calls
# go same-origin through the /api rewrite in vercel.json.
VITE_API_BASE_URL=http://localhost:5039

# Google Analytics 4 — public Measurement ID (not a secret).
VITE_GA_MEASUREMENT_ID=G-7RX9HLYJY5

# Google Tag Manager — container ID (not a secret).
VITE_GTM_CONTAINER_ID=GTM-N3KK5T9N
