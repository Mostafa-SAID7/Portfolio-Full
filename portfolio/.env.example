# Portfolio (public site) — environment template.
# Copy to .env.development (dev) and .env.production (prod), or set the same
# keys in your Vercel project settings. Never commit real secrets.

# Where the API lives. Empty in production (same-origin /api rewrite).
VITE_API_BASE_URL=http://localhost:5039

# Google Analytics 4 — public Measurement ID (not a secret).
# Leave empty to disable analytics entirely (no script loaded, no consent prompt).
VITE_GA_MEASUREMENT_ID=

# The site origin used for SEO / sitemap / structured data.
VITE_SITE_URL=https://portfolio-market.vercel.app
