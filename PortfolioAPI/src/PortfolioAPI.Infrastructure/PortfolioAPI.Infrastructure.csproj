<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.23">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.23" />
    <!-- The GA4 Data API client lives here: HttpClientFactory (outbound calls),
         Options (AnalyticsOptions) and logging. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.23" />
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Six Labors Split License (applies from ImageSharp 3.2.0): Release
       builds hard-fail without a license key. This mapping lets CI/CD and
       local shells pass the key as an environment variable instead of a
       file, so bumping to >= 3.2.0 (issue #127) becomes a one-secret change:
       set SIXLABORS_LICENSE_KEY (GitHub Actions secret / MonsterASP env).
       Obtain the free community license at https://sixlabors.com/pricing/.
       Deliberately inert until SIXLABORS_LICENSE_KEY is defined. -->
  <PropertyGroup>
    <SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == '' and '$(SIXLABORS_LICENSE_KEY)' != ''">$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortfolioAPI.Core\PortfolioAPI.Core.csproj" />
    <ProjectReference Include="..\PortfolioAPI.Application\PortfolioAPI.Application.csproj" />
  </ItemGroup>

  <!-- HTML email templates ship as embedded resources so the publish output
       stays a binary - no template files to forget when deploying. -->
  <ItemGroup>
    <EmbeddedResource Include="Emailing\Templates\**\*.html" />
  </ItemGroup>

  <!-- EmailService internals are unit-tested directly (subject sanitization,
       settings validation) – visible only to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PortfolioAPI.UnitTests" />
  </ItemGroup>

</Project>
