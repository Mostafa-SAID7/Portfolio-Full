<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

    <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <!-- The GA4 Data API client lives here: HttpClientFactory (outbound calls),
         Options (AnalyticsOptions) and logging. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortfolioAPI.Core\PortfolioAPI.Core.csproj" />
  </ItemGroup>

  <!-- HTML email templates ship as embedded resources so the publish output
       stays a binary - no template files to forget when deploying. -->
  <ItemGroup>
    <EmbeddedResource Include="Emailing\Templates\**\*.html" />
  </ItemGroup>

  <!-- EmailService internals are unit-tested directly (subject sanitization,
       settings validation) — visible only to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PortfolioAPI.UnitTests" />
  </ItemGroup>

</Project>
