{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio-dashboard/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://portfolio-market.runasp.net/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
